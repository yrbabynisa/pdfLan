# =============================================================
# PDFVault Docker Environment
# Salin file ini menjadi .env untuk konfigurasi kustom
# =============================================================

# Port yang akan di-expose ke host machine
APP_PORT=3000

# Waktu file temporary disimpan sebelum dihapus (menit)
FILE_TTL_MINUTES=120

# Ukuran maksimal file upload (MB)
MAX_FILE_SIZE_MB=50

# CORS origin. Kosongkan untuk same-origin only (aman, default).
# Set '*' untuk mengizinkan semua, atau daftar origin dipisah koma.
# Contoh: CORS_ORIGIN=http://192.168.1.10:3000
CORS_ORIGIN=

# PIN untuk akses Admin & Monitoring Dashboard (/admin)
# WAJIB diisi untuk mengaktifkan admin via web. Kosong = admin non-localhost dinonaktifkan.
# (Akses dari localhost/desktop manager tetap diizinkan via LOCALHOST_ADMIN_BYPASS.)
ADMIN_PIN=

